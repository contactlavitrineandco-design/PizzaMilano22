# Copier ce fichier en .env.local et remplir avec les valeurs du projet Supabase
# (Supabase > Project Settings > API). Ne jamais committer .env.local.

# Public : utilisées par le navigateur (lecture de la carte, session du personnel, temps réel).
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Adresse publique du site, sans « / » final (ex. https://www.pizzamilano-saintbrieuc.fr).
# Sert aux balises canoniques, au sitemap et aux données structurées. Sur Vercel,
# à défaut, le domaine de production du projet est utilisé.
NEXT_PUBLIC_SITE_URL=

# SECRET : utilisée uniquement côté serveur pour créer les commandes.
# Ne jamais la préfixer par NEXT_PUBLIC_, ne jamais l'utiliser dans un composant client.
SUPABASE_SERVICE_ROLE_KEY=

# SECRET : signe la session de l'espace gérant (/gerant). 32 caractères minimum, au hasard.
# Exemple pour en générer un : node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_SESSION_SECRET=
