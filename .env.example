# Copier ce fichier en .env.local et remplir avec les valeurs du projet Supabase
# (Supabase > Project Settings > API). Ne jamais committer .env.local.

# Public : lecture de la carte, des photos et des réglages (clé « anon », protégée par la RLS).
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Adresse publique du site, sans « / » final (ex. https://www.pizzamilano-saintbrieuc.fr).
# Sert aux balises canoniques, au sitemap et aux données structurées. Sur Vercel,
# à défaut, le domaine de production du projet est utilisé.
NEXT_PUBLIC_SITE_URL=

# Plus de clé secrète : le site ne crée plus de commandes (elles passent par SumUp).
